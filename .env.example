# GEMINI_API_KEY: Required for Google Veo 2 / Gemini Video generation.
# In AI Studio, this is automatically injected from user secrets or configured in the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# REPLICATE_API_TOKEN: Optional API token for external video models (Minimax Video-01, Wan, Luma Ray).
REPLICATE_API_TOKEN="MY_REPLICATE_API_TOKEN"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime by AI Studio.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default 3000)
PORT=3000
